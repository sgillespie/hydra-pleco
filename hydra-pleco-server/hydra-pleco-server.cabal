cabal-version: 3.4
name: hydra-pleco-server
version: 0.1.0.0
synopsis: The hydra-pleco API server
description:
  See README.md for more details.

license: MIT
author: Sean D Gillespie
maintainer: Sean D Gillespie <sean@mistersg.net>
copyright: 2026 Sean D Gillespie
category: Development
build-type: Simple
tested-with: ghc ==9.10.*
extra-source-files: db-test/data/seed.sql

common common-options
  build-depends:
    base >=4.16 && <5,
    exceptions,
    hydra-pleco-api,
    relude,
    unliftio,

  mixins:
    base hiding (Prelude),
    relude (Relude as Prelude),
    relude,

  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wderiving-defaults
    -Wmissing-deriving-strategies
    -Wincomplete-uni-patterns
    -Wredundant-constraints
    -Wnoncanonical-monad-instances
    -fhide-source-paths
    -Wmissing-export-lists
    -Wpartial-fields

  default-extensions:
    DataKinds
    DeriveAnyClass
    DeriveGeneric
    DerivingStrategies
    KindSignatures
    LambdaCase
    OverloadedStrings
    RecordWildCards
    TypeOperators

  default-language: GHC2021

library
  import: common-options
  hs-source-dirs: src
  exposed-modules:
    Hydra.Pleco.Server
    Hydra.Pleco.Server.DB
    Hydra.Pleco.Server.DB.Hydra
    Hydra.Pleco.Server.Error
    Hydra.Pleco.Server.Evals
    Hydra.Pleco.Server.Evals.DB
    Hydra.Pleco.Server.Jobsets
    Hydra.Pleco.Server.Jobsets.DB
    Hydra.Pleco.Server.Monad
    Hydra.Pleco.Server.Projects
    Hydra.Pleco.Server.Projects.DB
    Hydra.Pleco.Server.Webhook
    Hydra.Pleco.Server.Webhook.DB

  build-depends:
    aeson,
    aeson-pretty,
    clock,
    hasql,
    hasql-notifications,
    hasql-pool,
    http-client,
    http-media,
    http-types,
    katip,
    katip-wai,
    mtl,
    network-uri,
    rel8,
    servant,
    servant-client,
    servant-client-core,
    servant-server,
    servant-swagger-ui,
    text,
    uuid,
    warp,

library testlib
  import: common-options
  hs-source-dirs: testlib
  visibility: public
  exposed-modules:
    Hydra.Pleco.Server.Gen
    Hydra.Pleco.Server.TestApp
    Hydra.Pleco.Server.TestDb

  build-depends:
    hasql,
    hasql-pool,
    hedgehog,
    http-client,
    hydra-pleco-api:testlib,
    hydra-pleco-server,
    katip,
    rel8,
    warp,

executable hydra-pleco
  import: common-options
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
    hydra-pleco-api,
    hydra-pleco-server,
    optparse-applicative,
    warp,

  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

test-suite tests
  import: common-options
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    Hydra.Pleco.Server.DB.HydraSpec
    Hydra.Pleco.Server.ErrorSpec
    Hydra.Pleco.Server.EvalSpec
    Hydra.Pleco.Server.ProjectSpec
    Hydra.Pleco.ServerSpec

  build-depends:
    aeson,
    hedgehog,
    hspec,
    hspec-hedgehog,
    http-client,
    http-types,
    hydra-pleco-api:testlib,
    hydra-pleco-cli,
    hydra-pleco-server,
    hydra-pleco-server:testlib,
    servant-client,
    servant-server,
    warp,

  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

test-suite db-tests
  import: common-options
  type: exitcode-stdio-1.0
  hs-source-dirs: db-test
  main-is: Main.hs
  other-modules:
    Hydra.Pleco.Server.HydraDbSpec
    Hydra.Pleco.Server.ProjectsSpec
    Hydra.Pleco.Server.WebhookSpec

  build-depends:
    aeson,
    hasql,
    hasql-pool,
    hspec,
    http-types,
    hydra-pleco-cli,
    hydra-pleco-server,
    hydra-pleco-server:testlib,
    network-uri,
    rel8,
    servant-client,
    warp,

  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
